# Copy to .env for local runs. On Vercel set these under Settings → Environment Variables.

# Code for the family (sees family-only posts and can download everything).
FAMILY_CODE=
# Code for the site manager (also deletes posts and edits the page).
ADMIN_CODE=

# Postgres. On Vercel this is added automatically when Neon is connected to the project.
DATABASE_URL=postgres://postgres@localhost:5432/memorial

# Files in Google Drive (a folder in a Shared Drive; see README):
# GOOGLE_SERVICE_ACCOUNT_KEY=   the whole service account JSON key (or the same, base64-encoded)
# GOOGLE_DRIVE_FOLDER_ID=       the folder id from the Drive address bar
#
# Alternatively a private Vercel Blob store (adds BLOB_STORE_ID automatically).
# With neither, files are kept on disk in DATA_DIR (local runs only).
DATA_DIR=./data

# Optional
# PERSON_NAME=רני אלון
# MAX_FILE_MB=1024
# EXPORT_PART_MB=250
