# Copy to .env for local runs. In production set these in the host's settings.

# Code for the family (sees family-only posts and can download everything).
FAMILY_CODE=
# Code for the site manager (also deletes posts and edits the page).
ADMIN_CODE=

# Name shown at the top (can also be changed from the page itself).
PERSON_NAME=רני אלון

# Largest single file, in MB.
MAX_FILE_MB=2048

# ---- Storage: option A, disk (default) ----
# Folder for files and data. On Railway/Render/Fly point this at the mounted volume.
DATA_DIR=./data

# ---- Storage: option B, S3-compatible bucket (Cloudflare R2, AWS S3, ...) ----
# Setting S3_BUCKET switches to bucket storage; DATA_DIR is then not used.
# S3_BUCKET=
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
